<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="productosVendidos" whenNoDataType="NoDataSection" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
 <style name="Titulo" mode="Opaque" backcolor="#1F2937" forecolor="#FFFFFF"/>
 <style name="Cabecera" mode="Opaque" backcolor="#E2E8F0" forecolor="#1F2937" isBold="true"/>
 <style name="Texto" isDefault="true" fontName="SansSerif" fontSize="10" forecolor="#1F2937"/>
 <parameter name="DESDE" class="java.sql.Date"/><parameter name="HASTA" class="java.sql.Date"/>
 <queryString language="SQL"><![CDATA[SELECT pr.id_producto, pr.nombre, SUM(d.cantidad) unidades, SUM(d.subtotal) importe FROM detalle_pedido d JOIN productos pr ON pr.id_producto=d.id_producto WHERE EXISTS (SELECT 1 FROM pagos p WHERE p.id_pedido=d.id_pedido AND p.estado='Pagado' AND DATE(p.fecha_pago) BETWEEN $P{DESDE} AND $P{HASTA}) GROUP BY pr.id_producto, pr.nombre ORDER BY unidades DESC, pr.nombre]]></queryString>
 <field name="id_producto" class="java.lang.Integer"/><field name="nombre" class="java.lang.String"/><field name="unidades" class="java.math.BigDecimal"/><field name="importe" class="java.math.BigDecimal"/>
 <variable name="TotalUnidades" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{unidades}]]></variableExpression></variable>
 <variable name="TotalImporte" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{importe}]]></variableExpression></variable>
 <title><band height="90"><staticText><reportElement style="Titulo" x="0" y="0" width="555" height="30"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="16" isBold="true"/></textElement><text><![CDATA[RESTAURANTE - PRODUCTOS VENDIDOS]]></text></staticText><textField><reportElement x="0" y="36" width="555" height="20"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA["Periodo: " + $P{DESDE} + " al " + $P{HASTA}]]></textFieldExpression></textField><staticText><reportElement x="0" y="62" width="555" height="20" forecolor="#64748B"/><textElement textAlignment="Center"/><text><![CDATA[Resumen de cantidades y subtotales de productos en pedidos pagados.]]></text></staticText></band></title>
 <columnHeader><band height="25"><staticText><reportElement style="Cabecera" x="0" y="0" width="60" height="20"/><text><![CDATA[Código]]></text></staticText><staticText><reportElement style="Cabecera" x="60" y="0" width="270" height="20"/><text><![CDATA[Producto]]></text></staticText><staticText><reportElement style="Cabecera" x="330" y="0" width="105" height="20"/><textElement textAlignment="Right"/><text><![CDATA[Unidades]]></text></staticText><staticText><reportElement style="Cabecera" x="435" y="0" width="120" height="20"/><textElement textAlignment="Right"/><text><![CDATA[Importe (S/)]]></text></staticText></band></columnHeader>
 <detail><band height="22"><textField><reportElement x="0" y="0" width="60" height="18"/><textFieldExpression><![CDATA[$F{id_producto}]]></textFieldExpression></textField><textField><reportElement x="60" y="0" width="270" height="18"/><textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression></textField><textField><reportElement x="330" y="0" width="105" height="18"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{unidades}]]></textFieldExpression></textField><textField pattern="#,##0.00"><reportElement x="435" y="0" width="120" height="18"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{importe}]]></textFieldExpression></textField></band></detail>
 <pageFooter><band height="24"><line><reportElement x="0" y="0" width="555" height="1" forecolor="#CBD5E1"/></line><staticText><reportElement x="0" y="6" width="350" height="16" forecolor="#64748B"/><text><![CDATA[Sistema de gestión de restaurante]]></text></staticText><textField><reportElement x="435" y="6" width="120" height="16" forecolor="#64748B"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression></textField></band></pageFooter>
 <summary><band height="54"><staticText><reportElement x="0" y="5" width="330" height="18"/><text><![CDATA[Totales del periodo]]></text></staticText><textField><reportElement x="330" y="5" width="105" height="18"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$V{TotalUnidades} == null ? java.math.BigDecimal.ZERO : $V{TotalUnidades}]]></textFieldExpression></textField><textField pattern="#,##0.00"><reportElement x="435" y="5" width="120" height="18"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$V{TotalImporte} == null ? java.math.BigDecimal.ZERO : $V{TotalImporte}]]></textFieldExpression></textField><staticText><reportElement x="0" y="28" width="555" height="18" forecolor="#64748B"/><text><![CDATA[Importes por producto antes de descuentos generales de la venta.]]></text></staticText></band></summary>
 <noData><band height="30"><staticText><reportElement x="0" y="0" width="555" height="20"/><text><![CDATA[No hay productos vendidos para el periodo seleccionado.]]></text></staticText></band></noData>
</jasperReport>
