<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ventasRestaurante" whenNoDataType="NoDataSection" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
 <style name="Titulo" mode="Opaque" backcolor="#1F2937" forecolor="#FFFFFF"/>
 <style name="Cabecera" mode="Opaque" backcolor="#E2E8F0" forecolor="#1F2937" isBold="true"/>
 <style name="Texto" isDefault="true" fontName="SansSerif" fontSize="10" forecolor="#1F2937"/>
 <parameter name="DESDE" class="java.sql.Date"/>
 <parameter name="HASTA" class="java.sql.Date"/>
 <queryString language="SQL"><![CDATA[SELECT p.id_pago, p.fecha_pago, pe.codigo, p.metodo_pago, p.monto FROM pagos p JOIN pedidos pe ON pe.id_pedido=p.id_pedido WHERE p.estado='Pagado' AND DATE(p.fecha_pago) BETWEEN $P{DESDE} AND $P{HASTA} ORDER BY p.fecha_pago, p.id_pago]]></queryString>
 <field name="id_pago" class="java.lang.Integer"/><field name="fecha_pago" class="java.sql.Timestamp"/><field name="codigo" class="java.lang.String"/><field name="metodo_pago" class="java.lang.String"/><field name="monto" class="java.math.BigDecimal"/>
 <variable name="TotalVentas" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{monto}]]></variableExpression></variable>
 <title><band height="90"><staticText><reportElement style="Titulo" x="0" y="0" width="555" height="30"/><textElement textAlignment="Center" verticalAlignment="Middle"><font size="16" isBold="true"/></textElement><text><![CDATA[RESTAURANTE - REPORTE DE VENTAS]]></text></staticText><textField><reportElement x="0" y="36" width="555" height="20"/><textElement textAlignment="Center"/><textFieldExpression><![CDATA["Periodo: " + $P{DESDE} + " al " + $P{HASTA}]]></textFieldExpression></textField><staticText><reportElement x="0" y="62" width="555" height="20" forecolor="#64748B"/><textElement textAlignment="Center"/><text><![CDATA[Detalle de pagos registrados como pagados en el periodo.]]></text></staticText></band></title>
 <columnHeader><band height="25"><staticText><reportElement style="Cabecera" x="0" y="0" width="55" height="20"/><text><![CDATA[Pago]]></text></staticText><staticText><reportElement style="Cabecera" x="55" y="0" width="150" height="20"/><text><![CDATA[Fecha]]></text></staticText><staticText><reportElement style="Cabecera" x="205" y="0" width="110" height="20"/><text><![CDATA[Pedido]]></text></staticText><staticText><reportElement style="Cabecera" x="315" y="0" width="120" height="20"/><text><![CDATA[Método]]></text></staticText><staticText><reportElement style="Cabecera" x="435" y="0" width="120" height="20"/><textElement textAlignment="Right"/><text><![CDATA[Monto (S/)]]></text></staticText></band></columnHeader>
 <detail><band height="22"><textField><reportElement x="0" y="0" width="55" height="18"/><textFieldExpression><![CDATA[$F{id_pago}]]></textFieldExpression></textField><textField pattern="dd/MM/yyyy HH:mm"><reportElement x="55" y="0" width="150" height="18"/><textFieldExpression><![CDATA[$F{fecha_pago}]]></textFieldExpression></textField><textField><reportElement x="205" y="0" width="110" height="18"/><textFieldExpression><![CDATA[$F{codigo}]]></textFieldExpression></textField><textField><reportElement x="315" y="0" width="120" height="18"/><textFieldExpression><![CDATA[$F{metodo_pago}]]></textFieldExpression></textField><textField pattern="#,##0.00"><reportElement x="435" y="0" width="120" height="18"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$F{monto}]]></textFieldExpression></textField></band></detail>
 <pageFooter><band height="24"><line><reportElement x="0" y="0" width="555" height="1" forecolor="#CBD5E1"/></line><staticText><reportElement x="0" y="6" width="350" height="16" forecolor="#64748B"/><text><![CDATA[Sistema de gestión de restaurante]]></text></staticText><textField><reportElement x="435" y="6" width="120" height="16" forecolor="#64748B"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression></textField></band></pageFooter>
 <summary><band height="35"><staticText><reportElement x="315" y="5" width="120" height="20"/><text><![CDATA[Total del periodo:]]></text></staticText><textField pattern="#,##0.00"><reportElement x="435" y="5" width="120" height="20"/><textElement textAlignment="Right"/><textFieldExpression><![CDATA[$V{TotalVentas} == null ? java.math.BigDecimal.ZERO : $V{TotalVentas}]]></textFieldExpression></textField></band></summary>
 <noData><band height="30"><staticText><reportElement x="0" y="0" width="555" height="20"/><text><![CDATA[No hay ventas pagadas para el periodo seleccionado.]]></text></staticText></band></noData>
</jasperReport>

